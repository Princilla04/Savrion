# Local development environment template.
# Copy this file to `.env` and replace all placeholder values. Never commit `.env`.

PORT=5000
NODE_ENV=development

# Use a MongoDB URI locally or leave blank only when intentionally using the local development datastore.
MONGO_URI=mongodb://127.0.0.1:27017/savrion

# Generate a unique, long random value for every environment.
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRE=30d

# Initial administrator account. Change these before any shared or production deployment.
ADMIN_EMAIL=admin@savrion.in
ADMIN_PASSWORD=replace-with-a-strong-local-password

# Comma-separated origins permitted to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Leave unset locally to store uploads in backend/uploads. Configure these for Google Cloud Storage in production.
GCS_BUCKET_NAME=
GCS_PUBLIC_BASE_URL=
