NODE_ENV=production
PORT=8080

# Store sensitive values in Google Secret Manager; do not commit a real .env.production file.
MONGO_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@YOUR_CLUSTER.mongodb.net/savrion?retryWrites=true&w=majority
JWT_SECRET=GENERATE_A_LONG_RANDOM_VALUE
JWT_EXPIRE=30d
ADMIN_EMAIL=admin@savrion.in
ADMIN_PASSWORD=USE_A_UNIQUE_16_PLUS_CHARACTER_PASSWORD

ALLOWED_ORIGINS=https://savrion.in,https://admin.savrion.in
CLIENT_URL=https://savrion.in
ADMIN_URL=https://admin.savrion.in

# Cloud Run uses its service account automatically. Do not add a JSON key file.
GCS_BUCKET_NAME=savrion-production-uploads
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/savrion-production-uploads
